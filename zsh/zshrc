# nac-orchestrator aliases
source $HOME/.config/drs_utils.sh

export NAC_ORC_DIR="/home/jpaiva/Documents/NAC_ORCHESTRATOR_DIR"
create_orchestrator () {
  podman kill nac-default
  podman rm nac-default
  scripts=$(ls -l $NAC_ORC_DIR | awk '{print $11}' | grep orchestrator)
  container=$(ls -l $NAC_ORC_DIR | awk '{print $11}' | grep anycloud)
  python $NAC_ORC_DIR/setupEnvironment.py --workdir $NAC_ORC_DIR --container norc-docker-releases.repo.cci.nokia.net/anycloud_tools_external --scripts $NAC_ORC_DIR/$scripts  --name nac-default --containerManager podman 
}

create_orchestrator_named () {
  podman kill $1 
  podman rm $1
  scripts=$(ls -l $NAC_ORC_DIR | awk '{print $11}' | grep orchestrator)
  container=$(ls -l $NAC_ORC_DIR | awk '{print $11}' | grep anycloud)
  cp $NAC_ORC_DIR $NAC_ORC_DIR/workdir_$1 -a 
  python $NAC_ORC_DIR/workdir_$1/setupEnvironment.py --workdir $NAC_ORC_DIR/workdir_$1 --container norc-docker-releases.repo.cci.nokia.net/anycloud_tools_external --scripts $NAC_ORC_DIR/workdir_$1/$scripts  --name $1 --containerManager podman 
}

create_orchestrator_scratch () {
  rm -r $NAC_ORC_DIR/{product_build,scripts,config,global}
  podman kill nac-default
  podman rm nac-default
  scripts=$(ls -l $NAC_ORC_DIR | awk '{print $11}' | grep orchestrator)
  container=$(ls -l $NAC_ORC_DIR | awk '{print $11}' | grep anycloud)
  python $NAC_ORC_DIR/setupEnvironment.py --workdir $NAC_ORC_DIR --container norc-docker-releases.repo.cci.nokia.net/anycloud_tools_external --scripts $NAC_ORC_DIR/$scripts  --name nac-default --containerManager podman 
}

