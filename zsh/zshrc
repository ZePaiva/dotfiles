login_lab () {
  oc login api.$1.tre.nsn-rdnet.net:6443 -u nac -p nac1234 --insecure-skip-tls-verify
}

login_lab_admin () {
  if [ -d ~/Documents/labs/configs/$1 ]; then
    PWD=$(cat ~/Documents/labs/configs/${1}/config | grep VLAB_CLUSTER_PASSWORD | cut -d '=' -f2)
    oc login api.$1.tre.nsn-rdnet.net:6443 -u kubeadmin -p $PWD --insecure-skip-tls-verify
    if [ $? -ne 0 ]; then
      echo "Login failed, check lab config"
    fi
  else
    echo "Lab config not found, try updating"
  fi
}

login_sandbox () {
  oc login api.aao0142.tre.nsn-rdnet.net:6443 -u kubeadmin -p mLBg3-EaxQf-MxTAg-5GHZo --insecure-skip-tls-verify
}

login_vpn () {
  vpn_status=$(nmcli -f GENERAL.STATE con show NOKIA-VPN)
  if [ -z $vpn_status ]; then
    nmcli con up NOKIA-VPN --ask
    export HTTP_PROXY="http://ptamax01-proxy001.emea.nsn-net.net:8080"
  else
    nmcli con down NOKIA-VPN
    unset HTTP_PROXY
  fi
}

